# ---------------------------------------------------------------------------
# Visual Studio / .NET build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/

# Visual Studio user- and machine-specific state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# NuGet
*.nupkg
packages/
!packages/build/

# ---------------------------------------------------------------------------
# Service Fabric
# ---------------------------------------------------------------------------
# Generated application package: rebuilt on every deploy, hundreds of MB.
# The *sources* of the package (PackageRoot, manifests, publish profiles,
# application parameters) are tracked - only the build artefact is ignored.
pkg/
*.sfproj.user
ApplicationParameters/*.xml.user

# ---------------------------------------------------------------------------
# Node / Vite frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# npm/yarn diagnostics
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
# NOTE: .env IS tracked on purpose. The project specification requires the
# external service URLs (including the backend URL) to live in .env and to be
# read from there, so the file must be visible in the repository.
# It contains configuration only - never secrets.
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
